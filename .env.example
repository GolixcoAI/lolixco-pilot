# Frontend (public configuration only — frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://fhfkjviishfvfyawfckh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend / Modal secrets — never prefix with NEXT_PUBLIC_ (root .env)
# AI Inference Provider: "mock" (default for zero-credit safety) or "baseten"
AI_PROVIDER=mock

# Baseten Model API Configuration (Meta Global AI Developer Hackathon)
# Model endpoint: meta-models/muse-spark-open-1026
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# Meta Model API (Official Meta Model API)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Database Provider: "memory" (default for isolated development and tests) or "supabase"
DATABASE_PROVIDER=memory

# Supabase Auth & PostgreSQL (Singapore ap-southeast-1)
SUPABASE_URL=https://fhfkjviishfvfyawfckh.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://fhfkjviishfvfyawfckh.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ALLOW_DEV_TEST_AUTH=false
# AWS S3 Storage (Backend only)
# For local dev, boto3 supports the standard AWS CLI credential chain (~/.aws/credentials)
# You can leave AWS_ACCESS_KEY_ID empty if your local AWS CLI is already configured.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
USE_MOCK_STORAGE=false
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_SECONDS=60
SIGNED_URL_TTL_SECONDS=900
VIDEO_RETENTION_DAYS=7
DAILY_ANALYSIS_LIMIT=5
