{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LolixCopilotMediaObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_NAME}/users/*"
    },
    {
      "Sid": "LolixCopilotBucketMetadataInspection",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketCORS",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::${BUCKET_NAME}"
    }
  ]
}
