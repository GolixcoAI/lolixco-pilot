# Frontend (public configuration only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend / Modal secrets — never prefix with NEXT_PUBLIC_
# AI Inference Provider: "mock" (default for zero-credit safety) or "baseten"
AI_PROVIDER=mock

# Baseten Model API Configuration (Meta Global AI Developer Hackathon)
# Model endpoint: meta-models/muse-spark-open-1026
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# Meta Model API (Legacy / Alternative fallback)
MODEL_API_KEY=

# Supabase Auth & PostgreSQL
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# AWS S3 Storage (Backend only)
# For local dev, boto3 supports the standard AWS CLI credential chain (~/.aws/credentials)
# You can leave AWS_ACCESS_KEY_ID empty if your local AWS CLI is already configured.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=
USE_MOCK_STORAGE=false
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_SECONDS=60
SIGNED_URL_TTL_SECONDS=900
VIDEO_RETENTION_DAYS=7
DAILY_ANALYSIS_LIMIT=5
